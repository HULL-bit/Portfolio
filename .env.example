# Clé publique Web3Forms (https://web3forms.com) — le formulaire de contact bascule sur mailto: si elle est absente.
NEXT_PUBLIC_WEB3FORMS_KEY=
# Sous-dossier de déploiement (GitHub Pages : /nom-du-depot). Vide à la racine d'un domaine.
NEXT_PUBLIC_BASE_PATH=
# URL publique du site (canonical, sitemap, Open Graph). Défaut : https://www.souleymane-diaw.online
NEXT_PUBLIC_SITE_URL=
# Code GoatCounter (https://CODE.goatcounter.com) — statistiques sans cookie, désactivées si vide.
NEXT_PUBLIC_GOATCOUNTER=
